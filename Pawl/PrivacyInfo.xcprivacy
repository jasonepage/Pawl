<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pawl does not track users (no cross-app/cross-site tracking, no ads, no data brokers). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- 2.3: Pawl collects no data. The Supabase backend (account, ally links, heartbeats) was
	     removed. Everything stays on the phone and in the user's own iCloud. Keep this in sync
	     with the App Store Connect privacy "nutrition label" (Data Not Collected). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason API: the app and its App Group store settings/state in UserDefaults. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
